# ---- SkillBridge AI server configuration ----
# Copy to server/.env and fill in real values. Never commit server/.env.

NODE_ENV=development
PORT=5000

# Local MongoDB:      mongodb://localhost:27017/skillbridge
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillbridge?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/skillbridge

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API and open sockets (comma-separated).
CLIENT_URL=http://localhost:5173

# Python AI service
AI_SERVICE_URL=http://localhost:8000
# Shared secret; must equal AI_SERVICE_KEY in ai-service/.env. Required in production.
AI_SERVICE_KEY=
AI_TIMEOUT_MS=30000

# Max resume upload size in MB
MAX_UPLOAD_MB=5
