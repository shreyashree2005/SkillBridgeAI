# ---- SkillBridge AI service configuration ----
# Copy to ai-service/.env. Never commit the real file.

AI_ENV=development
# Must equal AI_SERVICE_KEY in server/.env. Required when AI_ENV=production.
AI_SERVICE_KEY=
MAX_UPLOAD_MB=5
# Folder containing taxonomy/ and generated/ (defaults to ../datasets)
# DATA_DIR=

# Optional language model for the career assistant: none | ollama | anthropic
# With "none" the assistant still works using its grounded rule-based engine.
LLM_PROVIDER=none
LLM_TIMEOUT_SECONDS=45

# Ollama (free, local): install from https://ollama.com then `ollama pull qwen2.5:3b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Anthropic (Claude): create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
